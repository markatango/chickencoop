	<div class="container-fluid">
		<div class="row">
			<div class="col-md-12 well">
				<h1 style="text-align: center;">Chicken Coop</h1>
			</div>
		</div>
		<div class="row">
			<div class="col-md-4">
				<!-- <h4 style="text-align: center;">Chicken coop time</h4> -->
	  			<h1 style="text-align: center;" id='clock'>CLOCK</h1>
  			</div>
			<div class="col-md-8">
				<h1 id="doorStateMsg" style="text-align: center;color: red;" id='openInd'>Door Status</h1>
			</div>
		</div>
		<div class="row">
			<div class="col-md-4">
				<h4 style="text-align: center;">Automatic Operation</h4>
						     
							
				<form id="timesform" class="form-horizontal">
				<div class="form-group">
					<!-- <div class="col-md-12"> -->
					<div class="col-md-12">
						<label class="control-label" for "dooropentime">Door open</label> 
						<input type="time" size="25" name="startTime" id="dooropentime" placeholder="Set time">
					</div>
					<!-- <div class="col-md-12"> -->
					<div class="col-md-12">
						<label class="control-label" for "doorclosetime">Door close</label>
						<input type="time" size="25" name="endTime" id="doorclosetime" placeholder="Set time">
					</div>							
				</div>
				<div class="form-group">
					<div class="row">
						<div class="col text-center">
							<button id="timesubmit" name="times" type="submit" class="btn btn-primary">Set time</button>
						</div>
					</div>
					
				</div>
				</form>	

			</div>
			<div class="col-md-8">
				<h4 style="text-align: center;">Manual Operation</h4>
				<!-- <h4 style="text-align: center;">Door Action</h4> -->
				<dev class="row">
					<div class="col text-center">
						<input type="button" value="Open" id="open">
						<input type="button" value="Close" id="close">	
					</div>
				</dev>
				<hr />
				<div class="row">
					<div class="col-md-12">
					</div>
					<div class="col-md-2"></div>
					<div class="col-md-3"><span style="text-align: center"><h5>Limits</h5></span></div>
					<div class="col-md-6"><span style="text-align: center"><h5>Inputs to Door Controller</h5></span></div>
					<div class="col-md-1"></div>
				</div>
				<div class="row">
					<div class="col-md-2"></div>
					<div class="col-md-2"><span style="text-align: center">Up</span></div>
					<div class="col-md-2"><span>Down</span></div>
					<div class="col-md-2"><span style="text-align: center">   Up</span></div>
					<div class="col-md-2"><span>Stop</span></div>
					<div class="col-md-2"><span>Down</span></div>
					
					<hr />
					<div class="col-md-12">
						<div class="row">
							<div class="col-md-2"></div>
							<div class="col-md-2"><span class="dot" id="ULS"><span class="dot-inner"></span></div>
							<div class="col-md-2"><span class="dot" id="LLS"><span class="dot-inner"></span></div>
							<div class="col-md-2"><span class="dot" id="UPI"><span class="dot-inner"></span></div>
							<div class="col-md-2"><span class="dot" id="STI"><span class="dot-inner"></span></div>
							<div class="col-md-2"><span class="dot" id="DNI"><span class="dot-inner"></span></div>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="col-md-12">
				<div data-mdb-input-init class="form-outline">
					<!-- <div style="text-align: center;">
					<label class="form-label" for="textAreaExample2"><h5>Log</h5></label>
					</div> -->
					
					<textarea readonly class="form-control" id="logmessage" rows="20"></textarea>
				</div>
			</div>
		</div>

		<footer class="footer">
			<!-- <p id="timeLog" class="text-muted">Time messages</p> -->
			<p id="timeLog" class="text-muted" style="text-align: center;">The Rodighiero Family</p>
		</footer>
	</div>







	


    


